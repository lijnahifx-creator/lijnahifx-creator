<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LIJNAHI RUNNER</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:#000;
    color:#fff;
    font-family:Arial,sans-serif;
    overflow:hidden;
    touch-action:none;
}

#game{
    position:relative;
    width:100vw;
    height:100vh;
    background:
      linear-gradient(#050505,#111);
    overflow:hidden;
}

/* TOP UI */
#top{
    position:absolute;
    top:15px;
    left:0;
    width:100%;
    display:flex;
    justify-content:space-around;
    z-index:20;
    font-size:18px;
    font-weight:bold;
}

.box{
    background:rgba(255,255,255,.08);
    padding:8px 14px;
    border-radius:12px;
    border:1px solid #333;
}

/* PLAYER */
#player{
    position:absolute;
    width:45px;
    height:60px;
    left:70px;
    bottom:80px;
    background:linear-gradient(135deg,#fff,#777);
    border-radius:12px;
    box-shadow:0 0 18px #fff;
}

/* EYES */
#player:before,
#player:after{
    content:"";
    position:absolute;
    width:7px;
    height:7px;
    background:#000;
    border-radius:50%;
    top:15px;
}

#player:before{left:10px;}
#player:after{right:10px;}

/* GROUND */
#ground{
    position:absolute;
    bottom:0;
    width:100%;
    height:70px;
    background:#080808;
    border-top:2px solid #444;
}

/* COIN */
.coin{
    position:absolute;
    width:25px;
    height:25px;
    border-radius:50%;
    background:#ffd700;
    box-shadow:0 0 15px #ffd700;
}

/* ENEMY */
.enemy{
    position:absolute;
    width:45px;
    height:55px;
    background:#222;
    border:2px solid #ff3333;
    border-radius:10px;
    box-shadow:0 0 15px #ff3333;
}

/* GAME OVER */
#gameOver{
    position:absolute;
    inset:0;
    background:rgba(0,0,0,.88);
    display:none;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    z-index:50;
    text-align:center;
}

#gameOver h1{
    font-size:42px;
    margin-bottom:15px;
}

#gameOver p{
    font-size:20px;
    margin-bottom:25px;
}

button{
    border:none;
    background:#fff;
    color:#000;
    padding:13px 28px;
    border-radius:25px;
    font-size:17px;
    font-weight:bold;
}

/* CONTROLS */
#controls{
    position:absolute;
    bottom:80px;
    right:20px;
    z-index:30;
}

#jumpBtn{
    width:75px;
    height:75px;
    border-radius:50%;
    background:#fff;
    color:#000;
    font-size:15px;
    font-weight:bold;
}

/* START SCREEN */
#start{
    position:absolute;
    inset:0;
    background:#000;
    z-index:60;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
}

#start h1{
    font-size:42px;
    letter-spacing:3px;
}

#start p{
    margin:15px 0 30px;
    color:#aaa;
}

#start button{
    cursor:pointer;
}
</style>
</head>

<body>

<div id="game">

    <!-- START -->
    <div id="start">
        <h1>LIJNAHI</h1>
        <p>RUNNER GAME</p>
        <button onclick="startGame()">START GAME</button>
    </div>

    <!-- SCORE -->
    <div id="top">
        <div class="box">🏆 <span id="score">0</span></div>
        <div class="box">🪙 <span id="coins">0</span></div>
        <div class="box">❤️ <span id="lives">3</span></div>
    </div>

    <!-- PLAYER -->
    <div id="player"></div>

    <!-- GROUND -->
    <div id="ground"></div>

    <!-- CONTROLS -->
    <div id="controls">
        <button id="jumpBtn">JUMP</button>
    </div>

    <!-- GAME OVER -->
    <div id="gameOver">
        <h1>GAME OVER</h1>
        <p>Score: <span id="finalScore">0</span></p>
        <button onclick="restartGame()">RESTART</button>
    </div>

</div>

<script>

const player = document.getElementById("player");
const game = document.getElementById("game");

const scoreText = document.getElementById("score");
const coinsText = document.getElementById("coins");
const livesText = document.getElementById("lives");

const gameOverScreen = document.getElementById("gameOver");
const finalScore = document.getElementById("finalScore");
const startScreen = document.getElementById("start");

let score = 0;
let coins = 0;
let lives = 3;

let playerBottom = 80;
let velocity = 0;
let gravity = 0.7;
let jumping = false;

let gameRunning = false;
let enemyTimer;
let coinTimer;
let scoreTimer;


/* START GAME */

function startGame(){

    startScreen.style.display = "none";

    gameRunning = true;

    score = 0;
    coins = 0;
    lives = 3;

    updateUI();

    enemyTimer = setInterval(createEnemy,1400);
    coinTimer = setInterval(createCoin,1000);
    scoreTimer = setInterval(()=>{
        score++;
        updateUI();
    },500);

    gameLoop();
}


/* UI */

function updateUI(){

    scoreText.textContent = score;
    coinsText.textContent = coins;
    livesText.textContent = lives;

}


/* JUMP */

function jump(){

    if(!gameRunning) return;

    if(!jumping){

        jumping = true;
        velocity = 14;

    }

}


/* BUTTON */

document.getElementById("jumpBtn").addEventListener("touchstart",(e)=>{
    e.preventDefault();
    jump();
});

document.getElementById("jumpBtn").addEventListener("click",jump);


/* KEYBOARD */

document.addEventListener("keydown",(e)=>{

    if(e.code === "Space"){
        jump();
    }

});


/* GAME LOOP */

function gameLoop(){

    if(!gameRunning) return;

    velocity -= gravity;

    playerBottom += velocity;

    if(playerBottom <= 80){

        playerBottom = 80;
        velocity = 0;
        jumping = false;

    }

    player.style.bottom = playerBottom + "px";

    requestAnimationFrame(gameLoop);

}


/* CREATE ENEMY */

function createEnemy(){

    if(!gameRunning) return;

    const enemy = document.createElement("div");

    enemy.classList.add("enemy");

    enemy.style.left = window.innerWidth + "px";
    enemy.style.bottom = "80px";

    game.appendChild(enemy);

    let x = window.innerWidth;

    const move = setInterval(()=>{

        if(!gameRunning){

            clearInterval(move);
            enemy.remove();
            return;

        }

        x -= 6;

        enemy.style.left = x + "px";

        if(collision(player,enemy)){

            clearInterval(move);

            enemy.remove();

            lives--;

            updateUI();

            if(lives <= 0){

                endGame();

            }

        }

        if(x < -60){

            clearInterval(move);
            enemy.remove();

        }

    },20);

}


/* CREATE COIN */

function createCoin(){

    if(!gameRunning) return;

    const coin = document.createElement("div");

    coin.classList.add("coin");

    let x = window.innerWidth;

    let y = 120 + Math.random() * 250;

    coin.style.left = x + "px";
    coin.style.bottom = y + "px";

    game.appendChild(coin);

    const move = setInterval(()=>{

        if(!gameRunning){

            clearInterval(move);
            coin.remove();
            return;

        }

        x -= 5;

        coin.style.left = x + "px";

        if(collision(player,coin)){

            coins++;
            score += 10;

            updateUI();

            clearInterval(move);
            coin.remove();

        }

        if(x < -40){

            clearInterval(move);
            coin.remove();

        }

    },20);

}


/* COLLISION */

function collision(a,b){

    const A = a.getBoundingClientRect();
    const B = b.getBoundingClientRect();

    return !(
        A.right < B.left ||
        A.left > B.right ||
        A.bottom < B.top ||
        A.top > B.bottom
    );

}


/* GAME OVER */

function endGame(){

    gameRunning = false;

    clearInterval(enemyTimer);
    clearInterval(coinTimer);
    clearInterval(scoreTimer);

    finalScore.textContent = score;

    gameOverScreen.style.display = "flex";

}


/* RESTART */

function restartGame(){

    location.reload();

}

</script>

</body>
</html>
