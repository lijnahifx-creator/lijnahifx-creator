<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LIJNAHI RUNNER</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  background:#000;
  overflow:hidden;
  font-family:Arial,sans-serif;
  touch-action:none;
}

#game{
  width:100vw;
  height:100vh;
  position:relative;
  overflow:hidden;
  background:linear-gradient(#07111c,#102c3d);
}

/* Stars */
.star{
  position:absolute;
  width:3px;
  height:3px;
  background:white;
  border-radius:50%;
  opacity:.7;
}

/* UI */
#ui{
  position:absolute;
  top:15px;
  left:0;
  width:100%;
  display:flex;
  justify-content:space-around;
  z-index:10;
}

.info{
  background:rgba(0,0,0,.6);
  color:white;
  padding:8px 15px;
  border-radius:15px;
  border:1px solid #555;
  font-weight:bold;
}

/* Player */
#player{
  position:absolute;
  width:45px;
  height:60px;
  left:70px;
  bottom:80px;
  background:white;
  border-radius:12px;
  box-shadow:0 0 20px white;
  z-index:5;
}

#player::before,
#player::after{
  content:"";
  position:absolute;
  width:7px;
  height:7px;
  background:#000;
  border-radius:50%;
  top:15px;
}

#player::before{
  left:10px;
}

#player::after{
  right:10px;
}

/* Ground */
#ground{
  position:absolute;
  bottom:0;
  width:100%;
  height:80px;
  background:#050505;
  border-top:3px solid #555;
}

/* Coin */
.coin{
  position:absolute;
  width:27px;
  height:27px;
  border-radius:50%;
  background:#ffd700;
  border:3px solid #fff;
  box-shadow:0 0 20px #ffd700;
  z-index:4;
}

/* Enemy */
.enemy{
  position:absolute;
  width:45px;
  height:55px;
  bottom:80px;
  background:#181818;
  border:2px solid red;
  border-radius:10px;
  box-shadow:0 0 15px red;
  z-index:4;
}

/* Jump Button */
#jump{
  position:absolute;
  bottom:100px;
  right:20px;
  width:80px;
  height:80px;
  border-radius:50%;
  border:none;
  background:white;
  color:black;
  font-weight:bold;
  z-index:20;
}

/* Start */
#start,
#over{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,.9);
  color:white;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  z-index:50;
}

#over{
  display:none;
}

h1{
  font-size:42px;
  letter-spacing:3px;
}

.subtitle{
  color:#aaa;
  margin:15px 0 30px;
}

.mainBtn{
  padding:14px 30px;
  border:none;
  border-radius:25px;
  font-size:17px;
  font-weight:bold;
}
</style>
</head>

<body>

<div id="game">

  <div id="start">
    <h1>LIJNAHI</h1>
    <div class="subtitle">RUNNER GAME</div>
    <button class="mainBtn" onclick="startGame()">START GAME</button>
  </div>

  <div id="over">
    <h1>GAME OVER</h1>
    <div class="subtitle">
      Score: <span id="finalScore">0</span>
    </div>
    <button class="mainBtn" onclick="location.reload()">RESTART</button>
  </div>

  <div id="ui">
    <div class="info">🏆 <span id="score">0</span></div>
    <div class="info">🪙 <span id="coins">0</span></div>
    <div class="info">❤️ <span id="lives">3</span></div>
  </div>

  <div id="player"></div>
  <div id="ground"></div>

  <button id="jump">JUMP</button>

</div>

<script>

const game = document.getElementById("game");
const player = document.getElementById("player");

let running = false;

let score = 0;
let coins = 0;
let lives = 3;

let playerY = 80;
let velocity = 0;
let jumping = false;

const gravity = 0.7;


/* START */

function startGame(){

  document.getElementById("start").style.display="none";

  running=true;

  createStars();

  setInterval(createCoin,1200);
  setInterval(createEnemy,1800);

  setInterval(()=>{
    if(running){
      score++;
      updateUI();
    }
  },500);

  gameLoop();
}


/* STARS */

function createStars(){

  for(let i=0;i<60;i++){

    const star=document.createElement("div");

    star.className="star";

    star.style.left=Math.random()*100+"%";
    star.style.top=Math.random()*70+"%";

    game.appendChild(star);
  }
}


/* JUMP */

function jump(){

  if(!running) return;

  if(!jumping){

    jumping=true;
    velocity=14;
  }
}

document.getElementById("jump").addEventListener("touchstart",e=>{
  e.preventDefault();
  jump();
});

document.getElementById("jump").onclick=jump;

document.addEventListener("keydown",e=>{
  if(e.code==="Space"){
    jump();
  }
});


/* GAME LOOP */

function gameLoop(){

  if(!running) return;

  velocity-=gravity;

  playerY+=velocity;

  if(playerY<=80){

    playerY=80;
    velocity=0;
    jumping=false;
  }

  player.style.bottom=playerY+"px";

  requestAnimationFrame(gameLoop);
}


/* COIN */

function createCoin(){

  if(!running) return;

  const coin=document.createElement("div");

  coin.className="coin";

  let x=window.innerWidth;
  let y=120+Math.random()*250;

  coin.style.left=x+"px";
  coin.style.bottom=y+"px";

  game.appendChild(coin);

  const move=setInterval(()=>{

    x-=6;

    coin.style.left=x+"px";

    if(hit(player,coin)){

      coins++;
      score+=10;

      updateUI();

      coin.remove();
      clearInterval(move);
    }

    if(x<-50){

      coin.remove();
      clearInterval(move);
    }

  },20);
}


/* ENEMY */

function createEnemy(){

  if(!running) return;

  const enemy=document.createElement("div");

  enemy.className="enemy";

  let x=window.innerWidth;

  enemy.style.left=x+"px";

  game.appendChild(enemy);

  const move=setInterval(()=>{

    x-=7;

    enemy.style.left=x+"px";

    if(hit(player,enemy)){

      lives--;

      updateUI();

      enemy.remove();
      clearInterval(move);

      if(lives<=0){

        endGame();
      }
    }

    if(x<-60){

      enemy.remove();
      clearInterval(move);
    }

  },20);
}


/* COLLISION */

function hit(a,b){

  const A=a.getBoundingClientRect();
  const B=b.getBoundingClientRect();

  return !(
    A.right<B.left ||
    A.left>B.right ||
    A.bottom<B.top ||
    A.top>B.bottom
  );
}


/* UI */

function updateUI(){

  document.getElementById("score").textContent=score;
  document.getElementById("coins").textContent=coins;
  document.getElementById("lives").textContent=lives;

}


/* GAME OVER */

function endGame(){

  running=false;

  document.getElementById("finalScore").textContent=score;

  document.getElementById("over").style.display="flex";
}

</script>

</body>
</html>
